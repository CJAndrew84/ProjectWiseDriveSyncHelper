<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ProjectWise Drive - Sync Cloud Projects"
    Width="920"
    Height="640"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock FontSize="22" FontWeight="Bold">ProjectWise Drive Sync</TextBlock>
            <TextBlock Foreground="#555555">Select connected cloud projects to sync to your PC. Up to 80 projects can be selected at once.</TextBlock>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Name="FilterTextBox" Grid.Column="0" Margin="0,0,8,0" VerticalContentAlignment="Center" Height="32" />
            <Button Name="SelectAllButton" Grid.Column="1" Width="110" Height="32" Margin="0,0,8,0">Select all</Button>
            <Button Name="ClearButton" Grid.Column="2" Width="110" Height="32" Margin="0,0,8,0">Clear</Button>
            <Button Name="RefreshButton" Grid.Column="3" Width="110" Height="32">Refresh</Button>
        </Grid>

        <ListBox Name="ProjectListBox" Grid.Row="2" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Name="SelectionCountText" FontWeight="SemiBold">0 selected</TextBlock>
                <TextBlock Margin="10,0,0,0" Foreground="#666666">Maximum 80</TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="SyncButton" Width="140" Height="36" Margin="0,0,8,0" Background="#1F6FEB" Foreground="White">Sync selected</Button>
                <Button Name="CancelButton" Width="90" Height="36">Close</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
